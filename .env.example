# ============================================================================
# Kiteezi Waste Management — environment variables
# ============================================================================
# Copy this file to `.env` (never commit `.env`) and replace placeholder
# values with real credentials from the secret manager / provider dashboards.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser by design.
# Do NOT add server-only secrets with that prefix.
# ============================================================================

# ----------------------------------------------------------------------------
# Database — Neon PostgreSQL (server-only)
# ----------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require
# Source: https://console.neon.tech → Project → Connection string
DATABASE_URL='your-postgresql-database-url-here'

# ----------------------------------------------------------------------------
# Session signing secret (server-only) — used to sign the session cookie JWT
# ----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# Rotating this value invalidates all existing sessions.
SESSION_SECRET='your-session-signing-secret-here'

# ----------------------------------------------------------------------------
# Google OAuth — sign-in
# ----------------------------------------------------------------------------
# Source: https://console.cloud.google.com/apis/credentials
#   → Create OAuth 2.0 Client ID → Web application
#   → Authorised JavaScript origins: add every origin the app is served from
#     (production domain, the stable Vercel branch alias, http://localhost:3000).
#     Preview URLs contain a per-deployment hash and change on every push — do
#     NOT whitelist those individually; use the stable alias instead.
#
# The SAME client id goes in both variables below. It is split in two on
# purpose:
#
#   NEXT_PUBLIC_… is bundled into the browser so Google Identity Services can
#   initialise. It is a public identifier, not a secret.
#
#   GOOGLE_OAUTH_CLIENT_ID is server-only and is the expected `aud` claim when
#   verifying an ID token. Token verification must not depend on a
#   browser-exposed variable, so it reads its own. If it is unset or blank,
#   verification FAILS CLOSED (it never falls back to accepting any audience)
#   and sign-in stops working.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID='your-google-oauth-client-id.apps.googleusercontent.com'
GOOGLE_OAUTH_CLIENT_ID='your-google-oauth-client-id.apps.googleusercontent.com'

# Note: no issuer variable is needed. Google publishes an OpenID discovery
# document, so the expected issuer is a documented constant in
# google-identity-provider.adapter.ts and is always enforced. (Web3Auth
# publishes none, which is why its issuer check had to be opt-in.)

# ----------------------------------------------------------------------------
# Transactional email (KWM-059) — password reset links
# ----------------------------------------------------------------------------
# Transport is chosen EXPLICITLY, never inferred from NODE_ENV. A transport
# that silently swallows mail based on an ambient value is one
# misconfiguration away from a production outage nobody notices, because every
# send keeps returning success.
#
#   console  — print the message (and the reset link) to the server log.
#              For local development, where there is no Resend account.
#   anything else / unset — send for real via Resend.
EMAIL_TRANSPORT='console'

# Source: https://resend.com → API Keys. Server-only.
# Required unless EMAIL_TRANSPORT=console.
RESEND_API_KEY='your-resend-api-key-here'

# The From address.
#
# With no domain of your own, use Resend's shared test sender:
#
#   EMAIL_FROM='Kiteezi <onboarding@resend.dev>'
#
# It needs no DNS, but delivers ONLY to the address on your Resend account —
# every other recipient gets a 403. Enough to prove the integration works;
# not enough for real users.
#
# For real users, use your own domain, verified in Resend with SPF/DKIM
# published. Without those, mail is rejected or silently filtered into spam,
# and silent filtering is the failure you will not notice because every send
# still reports success.
EMAIL_FROM='Kiteezi <onboarding@resend.dev>'

# Absolute base URL of this deployment, used to build the reset link.
# Built from config rather than the request Host header on purpose: trusting
# Host would let an attacker trigger a genuine-looking reset email pointing at
# a site they control.
NEXT_PUBLIC_APP_URL='http://localhost:3000'
